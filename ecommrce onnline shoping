<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Simple E-Commerce Shop</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f4f4f4;
}

header{
    background:#007bff;
    color:white;
    padding:15px;
    text-align:center;
}

nav{
    background:#0056b3;
    padding:10px;
    text-align:center;
}

nav a{
    color:white;
    text-decoration:none;
    margin:0 15px;
    font-weight:bold;
}

.products{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    padding:30px;
    gap:20px;
}

.card{
    background:white;
    width:250px;
    border-radius:10px;
    overflow:hidden;
    box-shadow:0 4px 10px rgba(0,0,0,0.2);
    text-align:center;
}

.card img{
    width:100%;
    height:220px;
    object-fit:cover;
}

.card h3{
    margin:10px 0;
}

.price{
    color:green;
    font-size:20px;
    margin:10px;
}

button{
    background:#007bff;
    color:white;
    border:none;
    padding:10px 20px;
    margin-bottom:15px;
    cursor:pointer;
    border-radius:5px;
}

button:hover{
    background:#0056b3;
}

footer{
    background:#333;
    color:white;
    text-align:center;
    padding:15px;
    margin-top:30px;
}
</style>
</head>

<body>

<header>
<h1>My E-Commerce Shop</h1>
<p>Best Deals Every Day</p>
</header>

<nav>
<a href="#">Home</a>
<a href="#">Products</a>
<a href="#">Cart</a>
<a href="#">Contact</a>
</nav>

<section class="products">

<div class="card">
<img src="https://via.placeholder.com/250x220" alt="Product">
<h3>Wireless Headphones</h3>
<p class="price">$49.99</p>
<button onclick="addCart()">Add to Cart</button>
</div>

<div class="card">
<img src="https://via.placeholder.com/250x220" alt="Product">
<h3>Smart Watch</h3>
<p class="price">$79.99</p>
<button onclick="addCart()">Add to Cart</button>
</div>

<div class="card">
<img src="https://via.placeholder.com/250x220" alt="Product">
<h3>Running Shoes</h3>
<p class="price">$59.99</p>
<button onclick="addCart()">Add to Cart</button>
</div>

<div class="card">
<img src="https://via.placeholder.com/250x220" alt="Product">
<h3>Backpack</h3>
<p class="price">$39.99</p>
<button onclick="addCart()">Add to Cart</button>
</div>

</section>

<footer>
<p>&copy; 2026 My E-Commerce Shop | All Rights Reserved</p>
</footer>

<script>
function addCart(){
    alert("Product added to cart!");
}
</script>

</body>
</html>
